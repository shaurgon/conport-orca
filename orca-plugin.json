{
  "manifestVersion": 2,
  "id": "conport-orca",
  "name": "ConPort Epics",
  "version": "0.1.0",
  "description": "Runs a ConPort epic with its spec and plan through Orca agents: pick an agent per role, start the run, follow the board, answer the stop-list questions.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "epics",
        "title": "ConPort Epics",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "run",
        "icon": "layers",
        "tooltip": "ConPort: epic run"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    }
  ]
}
